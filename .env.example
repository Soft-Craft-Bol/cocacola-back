# Copia este archivo como .env y completa tus valores. El .env real no se sube a git.

# Base de datos (Neon)
DB_URL=
DB_USER=
DB_PASSWORD=

# Seguridad
JWT_SECRET=
BI_API_KEY=

# Cloudinary (imágenes de eventos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Correo (Gmail: contraseña de aplicación)
MAIL_USERNAME=
MAIL_PASSWORD=

# Inteligencia artificial (OpenAI) y voz (ElevenLabs)
AI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# WhatsApp Business y CRM
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CRM_WEBHOOK_URL=
CRM_API_KEY=

